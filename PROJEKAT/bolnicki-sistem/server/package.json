        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/json2csv": "^5.0.7",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.6.0",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.0",
        "@types/react": "^19.2.14",
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.1.5",
        "dotenv-cli": "^11.0.0",
        "jest-mock-extended": "^4.0.1",
        "nodemon": "^3.1.14",
        "prisma": "^5.22.0",
